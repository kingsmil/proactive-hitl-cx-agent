OPENROUTER_API_KEY=sk-or-v1-...

# Set IS_GEMINI_MODEL=1 to route through Google Gemini instead of OpenRouter.
# GEMINI_MODEL defaults to gemini-2.0-flash when not set.
IS_GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
# Shared secret passed as X-Telegram-Bot-Api-Secret-Token on every webhook call.
# Set the same value when registering the webhook with Telegram's setWebhook API.
# Leave empty to skip verification (dev/localhost only).
TELEGRAM_WEBHOOK_SECRET=
